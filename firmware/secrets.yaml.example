# Copy to secrets.yaml (gitignored) and fill in.
wifi_ssid: "MeinWLAN"
wifi_password: "..."
# Upcoming router name and password (or the same as above when no change is planned).
wifi_ssid_next: "MeinWLAN"
wifi_password_next: "..."
# Fallback hotspot password (min. 8 characters), used only when the Wi-Fi is unreachable.
fallback_ap_password: "..."
# Protects over-the-air updates: openssl rand -hex 16
ota_password: "..."
ingest_url: "https://zvymcgkkjrfxqoartwrp.supabase.co/functions/v1/ingest"
# Same value as INGEST_SECRET in Supabase (Edge Functions -> Secrets).
ingest_secret: "..."
